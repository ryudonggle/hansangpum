# 식품안전나라 Open API 인증키 (https://www.foodsafetykorea.go.kr/api/main.do)
# 키 없으면 sample — 한 번에 5건만 돌려줌
FOODSAFETY_KEY=sample

# TypeSafe Jev — 애매한 쌍 "같은 상품인가?" 판정 (https://console.typesafe.ai)
TYPESAFE_API_KEY=

# Supabase Postgres 접속 문자열 (Supabase 대시보드 → Connect → ORMs 또는 Transaction pooler)
# 예: postgresql://postgres.<프로젝트ref>:<DB비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# /admin 검수·지표 화면 로그인 비밀번호 (직접 정하기)
ADMIN_PASSWORD=

# C006(축산물 품목제조보고+원재료) 전용 키. 비우면 FOODSAFETY_KEY 사용
FOODSAFETY_KEY_C006=
